# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME="Weekly Report Generator API"
API_V1_PREFIX="/api/v1"

# Comma-separated list of allowed CORS origins ("*" allows all - dev only).
CORS_ALLOW_ORIGINS="*"

# ---------------------------------------------------------------------------
# MongoDB
# ---------------------------------------------------------------------------
# Local:  mongodb://localhost:27017
# Atlas:  mongodb+srv://<user>:<url-encoded-password>@<cluster>.xxxx.mongodb.net/?retryWrites=true&w=majority&appName=<cluster>
# NOTE: URL-encode special characters in the password (@ -> %40, : -> %3A, / -> %2F, etc.).
MONGODB_URI="mongodb+srv://<user>:<url-encoded-password>@<cluster>.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=<cluster>"
MONGODB_DB_NAME="weekly_report"
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# JWT / Security
# ---------------------------------------------------------------------------
# Generate a strong value, e.g.  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY="change-me-to-a-long-random-string"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------------------------------------------------------------------
# Bootstrap
# ---------------------------------------------------------------------------
# Comma-separated emails that are granted the Manager role automatically on
# registration and promoted on application startup if they already exist.
BOOTSTRAP_ADMIN_EMAILS="admin@example.com"

# ---------------------------------------------------------------------------
# Email / SMTP (invite emails)
# ---------------------------------------------------------------------------
# Leave SMTP_HOST unset to disable outbound email - inviting a team member
# still works, but the temporary password is only returned in the API
# response (for the Manager to share out of band) instead of being emailed.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, and an App Password
# (not your normal password) for SMTP_PASSWORD.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL="no-reply@weeklyreport.dev"
SMTP_FROM_NAME="Weekly Report Generator"
SMTP_USE_TLS=true

# Used to build the sign-in link in invite emails.
FRONTEND_BASE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# AI chat assistant (OpenAI)
# ---------------------------------------------------------------------------
# Leave OPENAI_API_KEY unset to disable the /chat endpoints (they respond 503).
# Get a key at https://platform.openai.com/api-keys - never commit a real one.
OPENAI_API_KEY=
OPENAI_MODEL="gpt-4o-mini"
